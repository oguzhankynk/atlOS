{
    "C_Cpp.errorSquiggles": "disabled",
    "files.associations": {
        "cstddef": "cpp",
        "cstdint": "cpp",
        "new": "cpp",
        "*.inc": "cpp"
    },
    "doxygen_runner.configuration_file_override": "${workspaceFolder}/docs/Doxyfile",
    "doxdocgen.generic.authorEmail": "",
    "doxdocgen.generic.authorName": "Oguzhan KAYNAK",
    "doxdocgen.generic.commandSuggestionAddPrefix": true,
    "git.ignoreMissingGitWarning": true,
    "editor.wordWrap": "off",
    "debug.onTaskErrors": "debugAnyway"
}
