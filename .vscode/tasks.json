{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clear",
            "type": "shell",
            "command": "./run.sh clean",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },

        {
            "label": "Compile",
            "type": "shell",
            "command": "./run.sh clean build-all",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },

        {
            "label": "Create ISO",
            "type": "shell",
            "command": "./run.sh iso",
            "group": "build",
            "problemMatcher": []
        },

        {
            "label": "Run",
            "type": "shell",
            "command": "./run.sh run",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },

        {
            "label": "Build & Run",
            "type": "shell",
            "command": "./run.sh clean build-all iso run",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },

        {
            "label": "Create Disk Image (FAT16)",
            "type": "shell",
            "command": "./VirtualDisk/create_disk_image.sh 16",
            "group": "build",
            "problemMatcher": []
        }

    ]
}
