{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clear",
            "type": "shell",
            "command": "./run.sh clean",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "Compile",
            "type": "shell",
            "command": "./run.sh clean build-all",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "dependsOn": [
                "Clear"
            ]
        },
        {
            "label": "Create ISO",
            "type": "shell",
            "command": "./run.sh iso",
            "group": "build",
            "problemMatcher": [],
            "dependsOn": [
                "Compile"
            ]
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "./run.sh run",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "dependsOn": [
                "Create ISO"
            ]
        },
        {
            "label": "Run QEMU Debug",
            "type": "shell",
            "isBackground": true,
            "command": "qemu-system-x86_64 -cdrom atlOS.iso -m 1024M -no-shutdown -serial telnet:localhost:4321,server,nowait -S -s"
        },
        {
            "label": "Debug AtlOS",
            "dependsOn": [
                "Create ISO",
                "Run QEMU Debug"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Create Disk Image (FAT16)",
            "type": "shell",
            "command": "./VirtualDisk/create_disk_image.sh 16",
            "group": "build",
            "problemMatcher": []
        }
    ]
}