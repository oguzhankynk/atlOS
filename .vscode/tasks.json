{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean",
            "type": "shell",
            "command": "./scripts/build.sh clean",
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "./scripts/build.sh all",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "./scripts/build.sh run",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Self tests",
            "type": "shell",
            "command": "./scripts/build.sh selftest",
            "group": "test",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Crash test",
            "type": "shell",
            "command": "./scripts/build.sh crashtest",
            "group": "test",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Shell test",
            "type": "shell",
            "command": "./scripts/build.sh shelltest",
            "group": "test",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run QEMU Debug",
            "type": "shell",
            "isBackground": true,
            "command": "./scripts/build.sh debug",
            "problemMatcher": []
        },
        {
            "label": "Create Disk Image",
            "type": "shell",
            "command": "cmake --preset default > /dev/null && cmake --build --preset default --target disk-image",
            "problemMatcher": []
        },
        {
            "label": "Docs",
            "type": "shell",
            "command": "./scripts/build.sh docs",
            "problemMatcher": []
        },
        {
            "label": "Format",
            "type": "shell",
            "command": "./scripts/build.sh format",
            "problemMatcher": []
        },
        {
            "label": "Tidy",
            "type": "shell",
            "command": "./scripts/build.sh tidy",
            "problemMatcher": "$gcc"
        }
    ]
}
