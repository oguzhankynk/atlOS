KERNEL_ARCH_CFLAGS=
KERNEL_ARCH_CPPFLAGS=
KERNEL_ARCH_LDFLAGS=
KERNEL_ARCH_LIBS=

KERNEL_ARCH_OBJS=\
$(ARCHDIR)/boot/boot.o \

BIOS_SRCS := $(wildcard $(ARCHDIR)/BIOS/*.c)
BIOS_OBJS := $(patsubst $(ARCHDIR)/BIOS/%.c,$(ARCHDIR)/BIOS/%.o,$(BIOS_SRCS))
KERNEL_ARCH_OBJS += $(BIOS_OBJS)

CPU_SRCS := $(wildcard $(ARCHDIR)/cpu/*.c)
CPU_OBJS := $(patsubst $(ARCHDIR)/cpu/%.c,$(ARCHDIR)/cpu/%.o,$(CPU_SRCS))
KERNEL_ARCH_OBJS += $(CPU_OBJS)

tty_SRCS := $(wildcard $(ARCHDIR)/tty/*.c)
tty_OBJS := $(patsubst $(ARCHDIR)/tty/%.c,$(ARCHDIR)/tty/%.o,$(tty_SRCS))
KERNEL_ARCH_OBJS += $(tty_OBJS)
