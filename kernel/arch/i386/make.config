KERNEL_ARCH_CFLAGS=
KERNEL_ARCH_CPPFLAGS=
KERNEL_ARCH_LDFLAGS=
KERNEL_ARCH_LIBS=

KERNEL_ARCH_OBJS=\
$(ARCHDIR)/boot/boot.o \
$(ARCHDIR)/BIOS/SMBIOS/SMBIOS.o \
$(ARCHDIR)/BIOS/BIOS.o 


CPU_SRCS := $(wildcard $(ARCHDIR)/cpu/*.cpp)
CPU_OBJS := $(patsubst $(ARCHDIR)/cpu/%.cpp,$(ARCHDIR)/cpu/%.o,$(CPU_SRCS))
KERNEL_ARCH_OBJS += $(CPU_OBJS)

tty_SRCS := $(wildcard $(ARCHDIR)/tty/*.cpp)
tty_OBJS := $(patsubst $(ARCHDIR)/tty/%.cpp,$(ARCHDIR)/tty/%.o,$(tty_SRCS))
KERNEL_ARCH_OBJS += $(tty_OBJS)
