# Writes the kernel's version header; run at build time by the atlos_version target.
# Usage: cmake -DVERSION=<x.y.z> -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P generate-version.cmake
#
# The header is only rewritten when its content changes, so the kernel is not
# rebuilt on every build, only when the version or the git state changes.

string(REPLACE "." ";" parts "${VERSION}")
list(GET parts 0 major)
list(GET parts 1 minor)
list(GET parts 2 patch)

# e.g. v0.1.0, v0.1.0-3-g266d2d3, v0.1.0-3-g266d2d3-dirty, or the hash before the first tag
set(describe "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} describe --tags --match "v[0-9]*" --always --dirty
        WORKING_DIRECTORY ${SOURCE_DIR}
        OUTPUT_VARIABLE git_describe
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE result
        ERROR_QUIET
    )
    if(result EQUAL 0 AND git_describe)
        set(describe "${git_describe}")
    endif()
endif()

set(content "#pragma once

// Generated by cmake/generate-version.cmake from project(atlOS VERSION ...)
// in CMakeLists.txt and git describe. Do not edit.

#define ATLOS_VERSION_MAJOR ${major}
#define ATLOS_VERSION_MINOR ${minor}
#define ATLOS_VERSION_PATCH ${patch}
#define ATLOS_VERSION_STRING \"${VERSION}\"
#define ATLOS_GIT_DESCRIBE \"${describe}\"
")

if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} old)
    if(old STREQUAL content)
        return()
    endif()
endif()

file(WRITE ${OUTPUT} "${content}")
