{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 22,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "atlOS",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/toolchain-x86_64-elf.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "selftest",
            "displayName": "atlOS self tests",
            "inherits": "default",
            "cacheVariables": {
                "ATLOS_SELFTEST": "ON",
                "ATLOS_DEBUG_EXIT_PORT": "0xf4"
            }
        },
        {
            "name": "crashtest",
            "displayName": "atlOS crash test",
            "inherits": "default",
            "cacheVariables": {
                "ATLOS_CRASHTEST": "ON",
                "ATLOS_DEBUG_EXIT_PORT": "0xf4"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "selftest",
            "configurePreset": "selftest"
        },
        {
            "name": "crashtest",
            "configurePreset": "crashtest"
        }
    ],
    "testPresets": [
        {
            "name": "selftest",
            "configurePreset": "selftest",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "crashtest",
            "configurePreset": "crashtest",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
